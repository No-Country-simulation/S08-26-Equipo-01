
DB_HOST=localhost
DB_PORT=5432
DB_NAME=qualitytrack
DB_USER=qualitytrack
DB_PASSWORD=

# Base64-encoded secret containing at least 32 decoded bytes (256 bits).
JWT_SECRET=
JWT_ACCESS_EXPIRATION=15m
JWT_ISSUER=qualitytrack

EMAIL_VERIFICATION_EXPIRATION=24h
PASSWORD_RESET_EXPIRATION=30m
CUSTOMER_INVITATION_EXPIRATION=72h
INTERNAL_INVITATION_EXPIRATION=72h

CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_BASE_URL=http://localhost:5173

# Initial internal administrator bootstrap.
# Enable only when provisioning an environment without an existing INTERNAL ADMIN.
# Disable it again after the first administrator has been created successfully.
APP_BOOTSTRAP_ADMIN_ENABLED=false
APP_BOOTSTRAP_ADMIN_FIRST_NAME=
APP_BOOTSTRAP_ADMIN_LAST_NAME=
APP_BOOTSTRAP_ADMIN_EMAIL=
APP_BOOTSTRAP_ADMIN_PASSWORD=

# Document storage. Local is the safe default for development.
# Use cloudinary explicitly in shared/production environments and configure CLOUDINARY_URL.
DOCUMENT_STORAGE_PROVIDER=local
CLOUDINARY_URL=

DOCUMENT_STORAGE_ROOT=./storage/documents
DOCUMENT_MAX_FILE_SIZE=25MB
DOCUMENT_MAX_REQUEST_SIZE=130MB
DOCUMENT_MAX_FILES_PER_REQUEST=5

RESEND_APIKEY=
RESEND_EMAIL=QualityTrack@cambers.lat
RESEND_CONNECT_TIMEOUT=3s
RESEND_READ_TIMEOUT=5s
